# E2E Test Environment
# Copy to .env.test for use with dev-server mode (pnpm run test:e2e).
# The Docker mode (./scripts/test-e2e.sh) sets its own env vars and ignores this file.
#
# WARNING: global-setup.ts DELETEs ALL DATA from the configured database before each run.
# Never point this at your dev database unless you don't mind losing data.

NODE_ENV=development
LIBRIS_COOKIE_SECURE=0
TRUST_PROXY_HEADERS=0

# Isolated test database (use docker-compose.test.yml to spin one up)
#   docker compose -f docker-compose.test.yml up -d --wait
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=libris_test
POSTGRES_PASSWORD=libris_test
POSTGRES_DB=libris_test

REDIS_HOST=localhost
REDIS_PORT=6380

# File storage (temp dirs, safe to delete)
LIBRIS_INBOX_PATH=/tmp/libris-e2e/inbox
LIBRIS_LIBRARY_PATH=/tmp/libris-e2e/library

# Secrets. Throwaway values, but generated the same way production's are
# (`openssl rand -hex 32`): the API rejects published placeholders and
# low-diversity strings at startup, and TEST_ROUTE_TOKEN must be at least 32
# bytes or every /__test/ support-route call silently 401s.
API_SECRET_KEY=1e368ee3513dd6e7807d83fdcca3e0a2dc06e66d70ab903298c5130740ca9669
BETTER_AUTH_SECRET=f46f4321bb1c145197e08b5f773973faa4f70b0aefcdd9a3d09736e62b37a462
TEST_ROUTE_TOKEN=2264bacc352498319d641fb2bc92228c83cda488e1bc8676e87623dfc8cd1455
