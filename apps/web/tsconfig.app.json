{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The web program follows imports into services/api-hono source (its
    // `client`/`types` exports). The EPUB worker graph there must import with
    // explicit `.ts` extensions because it runs under Node's native type
    // stripping — see services/api-hono/tsconfig.json.
    "allowImportingTsExtensions": true,
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite-plus/client"],
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/auto-imports.d.ts",
    "src/components.d.ts",
    "src/typed-router.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
