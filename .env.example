# =============================================================================
# Libris — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# See docs/environment.md for the full reference.
#
# Generate secrets with:  openssl rand -hex 32

# Required. Never inferred: omitting it must not disable production safeguards.
NODE_ENV=development
LIBRIS_COOKIE_SECURE=0

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------

# PostgreSQL — split vars shared with docker-compose.dev.yml. The app
# assembles the connection URL from these (see src/lib/resolve-database-url.ts).
# Compose interpolates the same vars, so .env is the single source of truth.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=libris
POSTGRES_PASSWORD=changeme
POSTGRES_DB=libris

# -----------------------------------------------------------------------------
# Redis (required)
# -----------------------------------------------------------------------------

# Redis — also assembled from split vars (see src/lib/resolve-redis-url.ts).
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional Redis auth (most local dev setups don't need these)
# REDIS_USER=
# REDIS_PASSWORD=

# Set to 1 to use rediss:// (TLS). Required for most managed Redis providers.
# REDIS_TLS=0

# -----------------------------------------------------------------------------
# File Storage (required)
# -----------------------------------------------------------------------------

# Directory watched for newly uploaded book files
LIBRIS_INBOX_PATH=/data/inbox

# Directory for the organized book library
LIBRIS_LIBRARY_PATH=/data/library

# Comma-separated exact origins allowed to serve covers from private/special-use
# networks. Include scheme and non-default port, if any. Paths are not allowed.
# LIBRIS_COVER_FETCH_ALLOWLIST=http://covers.lan:8080,https://covers.example.com

# -----------------------------------------------------------------------------
# Security (required)
# -----------------------------------------------------------------------------

# Secret used for third-party token encryption. Empty and low-diversity values
# are rejected; do not paste the example generation command itself as a value.
# Generate: openssl rand -hex 32
API_SECRET_KEY=

# Signs Better Auth session cookies. Minimum 32 characters. Empty, published
# placeholder and low-diversity values are rejected; do not paste the example
# generation command itself as a value.
# Generate: openssl rand -base64 32
#
# Separate from API_SECRET_KEY on purpose — the two rotate independently, and
# there is deliberately no fallback: the server refuses to start without it.
# Changing it signs out every user.
BETTER_AUTH_SECRET=

# -----------------------------------------------------------------------------
# Cookies & Networking
# -----------------------------------------------------------------------------

# Public origin of the app, exactly as users reach it — scheme and host only,
# no path (e.g. https://libris.example.com).
#
# REQUIRED when NODE_ENV=production: the server refuses to start without it.
# Better Auth cannot infer an https origin behind a TLS-terminating proxy — it
# reads the container's plain-http socket address and then answers every
# browser request carrying an https Origin with 403, so nobody can sign in.
#
# Leave empty ONLY for local development, where the request origin is correct.
BETTER_AUTH_URL=

# Set to 1 only behind a trusted reverse proxy if auth logging and rate limiting
# should use X-Forwarded-For / X-Real-IP instead of the direct TCP peer address.
TRUST_PROXY_HEADERS=0
# Required when TRUST_PROXY_HEADERS=1. Use the immediate reverse proxy's exact
# address or narrow network; never list a whole client/LAN range.
# LIBRIS_TRUSTED_PROXIES=172.18.0.5/32

# Port for the API server (default: 3000)
# PORT=3000

# -----------------------------------------------------------------------------
# Logging (optional)
# -----------------------------------------------------------------------------

# Minimum log level: trace, debug, info, warn, error, fatal. Applies to both
# stdout (Pino) and the OpenTelemetry log pipeline. Default: info
# LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Rate Limiting (optional)
# -----------------------------------------------------------------------------

# Defaults are sized for LAN/VPN deployments. Lower these (e.g. 100/10/5) when
# exposing Libris publicly. See docs/architecture.md#rate-limiting for the
# per-endpoint tier mapping.
# LIBRIS_RATELIMIT_GENERAL_LIMIT=600
# LIBRIS_RATELIMIT_GENERAL_WINDOW_SECONDS=60
# LIBRIS_RATELIMIT_AUTH_LIMIT=30
# LIBRIS_RATELIMIT_AUTH_WINDOW_SECONDS=60
# LIBRIS_RATELIMIT_KEY_CREATION_LIMIT=30
# LIBRIS_RATELIMIT_KEY_CREATION_WINDOW_SECONDS=3600

# Bound incomplete headers and request bodies (slowloris), and the gap between
# requests on a kept-alive connection. None of these caps how long a request
# handler may take, so a slow but legitimate request still gets to answer.
# LIBRIS_HTTP_HEADERS_TIMEOUT_MS=10000
# LIBRIS_HTTP_REQUEST_TIMEOUT_MS=30000
# LIBRIS_HTTP_IDLE_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# OpenTelemetry (optional)
# -----------------------------------------------------------------------------

# Set OTEL_EXPORTER_OTLP_ENDPOINT to enable telemetry export. The OTel SDK
# adds zero overhead when this var is unset. All other OTEL_* vars use
# standard OTel defaults — see docs/environment.md for the full list.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# OTEL_SERVICE_NAME=libris
