# =============================================================================
# Libris — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# See docs/environment.md for the full reference.
#
# Generate secrets with:  openssl rand -hex 32

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------

# PostgreSQL — split vars shared with docker-compose.dev.yml. The app
# assembles the connection URL from these (see src/lib/resolve-database-url.ts).
# Compose interpolates the same vars, so .env is the single source of truth.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=libris
POSTGRES_PASSWORD=changeme
POSTGRES_DB=libris

# -----------------------------------------------------------------------------
# Redis (required)
# -----------------------------------------------------------------------------

# Redis — also assembled from split vars (see src/lib/resolve-redis-url.ts).
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional Redis auth (most local dev setups don't need these)
# REDIS_USER=
# REDIS_PASSWORD=

# Set to 1 to use rediss:// (TLS). Required for most managed Redis providers.
# REDIS_TLS=0

# -----------------------------------------------------------------------------
# File Storage (required)
# -----------------------------------------------------------------------------

# Directory watched for newly uploaded book files
LIBRIS_INBOX_PATH=/data/inbox

# Directory for the organized book library
LIBRIS_LIBRARY_PATH=/data/library

# -----------------------------------------------------------------------------
# Security (required)
# -----------------------------------------------------------------------------

# Secret used for API key and token encryption. Minimum 32 characters.
# Generate: openssl rand -hex 32
API_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# Cookies & Networking (optional)
# -----------------------------------------------------------------------------

# Shared parent domain for the auth cookie (e.g. .example.com).
# Leave empty when the API and web app share the same origin.
COOKIE_DOMAIN=

# Set to 1 only behind a trusted reverse proxy if auth logging and rate limiting
# should use X-Forwarded-For / X-Real-IP instead of the direct TCP peer address.
TRUST_PROXY_HEADERS=0

# Port for the API server (default: 3000)
# PORT=3000

# -----------------------------------------------------------------------------
# Logging (optional)
# -----------------------------------------------------------------------------

# Minimum log level: trace, debug, info, warn, error, fatal. Applies to both
# stdout (Pino) and the OpenTelemetry log pipeline. Default: info
# LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Rate Limiting (optional)
# -----------------------------------------------------------------------------

# Defaults are sized for LAN/VPN deployments. Lower these (e.g. 100/10/5) when
# exposing Libris publicly. See docs/architecture.md#rate-limiting for the
# per-endpoint tier mapping.
# LIBRIS_RATELIMIT_GENERAL_LIMIT=600
# LIBRIS_RATELIMIT_GENERAL_WINDOW_SECONDS=60
# LIBRIS_RATELIMIT_AUTH_LIMIT=30
# LIBRIS_RATELIMIT_AUTH_WINDOW_SECONDS=60
# LIBRIS_RATELIMIT_KEY_CREATION_LIMIT=30
# LIBRIS_RATELIMIT_KEY_CREATION_WINDOW_SECONDS=3600

# -----------------------------------------------------------------------------
# OpenTelemetry (optional)
# -----------------------------------------------------------------------------

# Set OTEL_EXPORTER_OTLP_ENDPOINT to enable telemetry export. The OTel SDK
# adds zero overhead when this var is unset. All other OTEL_* vars use
# standard OTel defaults — see docs/environment.md for the full list.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# OTEL_SERVICE_NAME=libris
